# ============================================================
# SMM Panel API — REQUIRED ENVIRONMENT (server-side)
# Scripts/services expected for dev; on Vercel set these in the
# smm-pannel-api project (Settings → Environment Variables → Production).
# Values are placeholders ONLY — copy to .env.local and use REAL values.
# Never commit real secrets.
# ============================================================

# DATABASE (required) — MongoDB connection string.
# Production (Vercel): a MongoDB Atlas cluster string, e.g.
#   mongodb+srv://user:password@cluster0.mongodb.net/smm_panel
# The Atlas IP access list must allow the Vercel region.
MONGODB_URI=mongodb://127.0.0.1:27017/smm_panel

# SERVER
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000

# SUPER ADMIN (required — the seed creates this account idempotently)
SUPER_ADMIN_EMAIL=superadmin@example.com
# REQUIRED — at least 8 characters in production.
SUPER_ADMIN_PASSWORD=

# JWT (required)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# SESSION (required)
COOKIE_SECRET=

# CORS — extra comma-separated origins accepted in addition to the built-in
# production panel origins and the localhost dev origins.
API_CORS_ORIGINS=

# PANEL ORIGINS (used for CORS + redirects; optional, dev defaults apply in dev)
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPER_ADMIN_APP_URL=http://localhost:3002

# SUBDOMAINS (admin-panel subdomains; optional)
NEXT_PUBLIC_ROOT_DOMAIN=localhost
ROOT_DOMAIN=localhost

# GOOGLE OAUTH (user panel — optional; server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# OTHER (optional)
REDIS_URL=