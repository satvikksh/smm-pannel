# ============================================================
# SMM Panel — SINGLE SOURCE OF TRUTH FOR ENVIRONMENT CONFIG
# Copy this file to `.env.local` and fill in real values.
# `.env.local` overrides `.env` and is git-ignored.
# Only variables prefixed NEXT_PUBLIC_ are exposed to browsers.
# ============================================================

# DATABASE
MONGODB_URI=mongodb://127.0.0.1:27017/smm_panel

# SERVER
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_CORS_ORIGIN_1=http://localhost:3000
API_CORS_ORIGIN_2=http://localhost:3001
API_CORS_ORIGIN_3=http://localhost:3002

# FRONTEND
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_SUPER_ADMIN_APP_URL=http://localhost:3002

# SUBDOMAINS
# Root domain for admin panels (production: smmpannel.com, local dev: localhost).
# NEXT_PUBLIC_ROOT_DOMAIN is used by the browser; ROOT_DOMAIN is server-only.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
ROOT_DOMAIN=localhost

# SUPER ADMIN (seeded at startup — must be set in .env.local)
SUPER_ADMIN_EMAIL=superadmin@smm.test
SUPER_ADMIN_PASSWORD=

# GOOGLE OAUTH (user panel login/register — optional; server-side only)
# Create an OAuth 2.0 client at https://console.cloud.google.com (Authorized
# redirect URIs must include GOOGLE_REDIRECT_URI). Keep the secret in .env.local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# SESSION
COOKIE_SECRET=

# OTHER SERVICES (optional)
REDIS_URL=